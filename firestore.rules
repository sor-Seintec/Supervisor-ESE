rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSupervisor() {
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    function ownsSupervisorProfile(supervisorId) {
      return isSupervisor()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.supervisorId == supervisorId;
    }

    match /users/{userId} {
      allow read: if activeUser()
        && (request.auth.uid == userId || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    match /supervisors/{supervisorId} {
      allow get: if isAdmin() || ownsSupervisorProfile(supervisorId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
