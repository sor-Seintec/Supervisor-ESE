rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    function isAdmin() {
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isSupervisor() {
      return activeUser()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    function ownsSupervisorProfile(supervisorId) {
      return isSupervisor()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.supervisorId == supervisorId;
    }

    match /users/{userId} {
      allow read: if activeUser()
        && (request.auth.uid == userId || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    match /supervisors/{supervisorId} {
      allow get: if isAdmin() || ownsSupervisorProfile(supervisorId);
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /schools/{schoolId} {
      allow read: if isAdmin()
        || ownsSupervisorProfile(resource.data.supervisorId);

      allow create, update, delete: if isAdmin();
    }

    match /visits/{visitId} {
      allow read: if isAdmin()
        || ownsSupervisorProfile(resource.data.supervisorId);

      allow create: if isAdmin()
        || (ownsSupervisorProfile(request.resource.data.supervisorId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.schemaVersion == 1);

      allow update: if isAdmin()
        || (ownsSupervisorProfile(resource.data.supervisorId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'visitDate',
            'status',
            'statusCode',
            'justification',
            'folderAction',
            'updatedAt'
          ]));

      allow delete: if isAdmin();
    }

    match /agenda/{agendaId} {
      allow read: if isAdmin()
        || ownsSupervisorProfile(resource.data.supervisorId);

      allow create: if isAdmin()
        || (ownsSupervisorProfile(request.resource.data.supervisorId)
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.schemaVersion == 1);

      allow update: if isAdmin()
        || (ownsSupervisorProfile(resource.data.supervisorId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'scheduledDate',
            'shift',
            'status',
            'updatedAt'
          ]));

      allow delete: if isAdmin();
    }

    match /actions/{actionId} {
      allow read: if activeUser();
      allow create, update, delete: if isAdmin();
    }

    match /migrations/{migrationId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
